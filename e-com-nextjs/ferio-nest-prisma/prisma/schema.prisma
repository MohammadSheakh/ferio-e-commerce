// Source: user/oauthAccount.prisma
model OAuthAccount {
  id           String        @id @default(cuid())

  // 🔗 Many OAuth accounts can belong to one user.
  userId       String
  user         User          @relation(fields: [userId], references: [id])

  // Provider identity, such as Google sub or Apple sub.
  authProvider OAuthProvider
  providerId   String
  email        String

  // Sensitive provider tokens. Keep these protected at application level.
  accessToken  String?
  refreshToken String?
  idToken      String?

  isVerified   Boolean       @default(true)
  lastUsedAt   DateTime?
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // One provider account should only be linked once globally.
  @@unique([authProvider, providerId])
  @@index([userId, isDeleted])
  @@index([authProvider, providerId, isDeleted])
  @@index([email, isDeleted])
  @@index([providerId, isDeleted])
}


// Source: user/staffAccessToken.prisma
model StaffAccessToken {
  id             String                  @id @default(cuid())
  email          String
  name           String?
  permissions    String[]                @default([])
  purpose        StaffAccessTokenPurpose
  tokenHash      String                  @unique
  targetUserId   String?
  issuedByUserId String
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([email, purpose, consumedAt, expiresAt])
  @@index([targetUserId, purpose, consumedAt])
  @@index([issuedByUserId, createdAt])
}


// Source: user/user.prisma
model User {
  id                  String           @id @default(cuid())
  name                String
  email               String           @unique
  password            String?
  role                UserRole
  profileImageUrl     String           @default("/uploads/users/user.png")
  phoneNumber         String?
  isEmailVerified     Boolean          @default(false)
  authProvider        UserAuthProvider @default(local)
  preferredTime       String           @default("07:00")
  isResetPassword     Boolean          @default(false)
  failedLoginAttempts Int              @default(0)
  lockUntil           DateTime?
  staffAccessStatus   StaffAccessStatus?
  staffPermissions    String[]          @default([])
  staffSessionVersion Int               @default(0)
  twoFactorEnabled              Boolean  @default(false)
  twoFactorSecretEncrypted      String?
  twoFactorPendingEncrypted     String?
  twoFactorRecoveryCodeHashes   String[] @default([])

  // 🔗 One user can have one wallet.
  walletId String? @unique
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  // 🔗 One user can have one primary profile link.
  profileId String?      @unique
  profile   UserProfile? @relation("UserProfileLink", fields: [profileId], references: [id])

  // 🔗 One parent/creator user can create many child accounts.
  accountCreatorId String?
  accountCreator   User?   @relation("UserAccountCreator", fields: [accountCreatorId], references: [id])
  childAccounts    User[]  @relation("UserAccountCreator")

  customerId String?   @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  isDeleted Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // == Back-relations
  // 🔗 One user can have many withdrawal requests.
  withdrawalRequests WithdrawalRequest[]

  // 🔗 One user can save many bank info records.
  bankInfos BankInfo[]

  // 🔗 One user can have many wallet transaction histories.
  walletTransactionHistories WalletTransactionHistory[]
  walletTopUps WalletTopUp[]

  // 🔗 One user can own one profile record.
  ownedProfile UserProfile? @relation("UserProfileOwner")

  // 🔗 One user can have many registered devices.
  devices UserDevices[]

  // 🔗 One user can link many OAuth provider accounts.
  oauthAccounts OAuthAccount[]
  carts         Cart[]
  savedCarts    SavedCart[]

  // 🔗 One user can have many role-specific data records.
  roleData UserRoleData[]

  // 🔗 One user can create many conversations.
  createdConversations Conversation[] @relation("ConversationCreator")

  // 🔗 One user can request many products.
  productRequests ProductRequest[] @relation("ProductRequestUser")

  // 🔗 One user can participate in many conversations.
  conversationParticipents ConversationParticipents[]

  // 🔗 One user can send many chat messages.
  sentMessages Message[] @relation("MessageSender")

  // 🔗 One user can have many message read status rows.
  messageReadStatuses MessageReadStatus[]

  // 🔗 One user can send many notifications.
  sentNotifications Notification[] @relation("NotificationSender")

  // 🔗 One user can receive many notifications.
  receivedNotifications Notification[] @relation("NotificationReceiver")

  
  // 🔗 One user can have many payment transactions.
  paymentTransactions PaymentTransaction[]
  submittedYoutubeReviews ProductYoutubeReview[] @relation("YoutubeReviewSubmitter")
  moderatedYoutubeReviews ProductYoutubeReview[] @relation("YoutubeReviewModerator")
  submittedWarrantyClaims WarrantyClaim[] @relation("WarrantyClaimSubmitter")
  handledWarrantyClaims WarrantyClaim[] @relation("WarrantyClaimHandler")

  // 🔗 One user can have many Stripe Connect accounts over time.
  stripeAccounts StripeAccount[]

  // 🔗 One user can have one delivery personnel profile.
  deliveryPersonnel DeliveryPersonnel?

  @@index([email, isDeleted])
  @@index([role, isDeleted])
  @@index([role, staffAccessStatus, isDeleted])
  @@index([role, isEmailVerified, isDeleted])
  @@index([accountCreatorId, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: user/userDevices.prisma
model UserDevices {
  id              String     @id @default(cuid())

  // 🔗 Many devices can belong to one user.
  userId          String
  user            User       @relation(fields: [userId], references: [id])

  fcmToken        String
  deviceType      DeviceType @default(web)
  deviceName      String?
  deviceOsVersion String?
  appVersion      String?
  lastActive      DateTime   @default(now())
  pushEnabled     Boolean    @default(true)
  isDeleted       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId, isDeleted])
  @@index([fcmToken, isDeleted])
  @@index([deviceType, isDeleted])
  @@index([lastActive, isDeleted])
}


// Source: user/userProfile.prisma
model UserProfile {
  id                        String             @id @default(cuid())

  // 🔗 One user profile belongs to one user.
  userId                    String             @unique
  user                      User               @relation("UserProfileOwner", fields: [userId], references: [id])

  // 🔗 Optional reverse side for User.profileId primary profile relation.
  linkedUser                User?              @relation("UserProfileLink")

  location                  String?
  dob                       DateTime?
  gender                    String?
  acceptTOC                 Boolean            @default(false)
  supportMode               String             @default("calm")
  notificationStyle         String             @default("gentle")
  providerApprovalStatus    UserApprovalStatus @default(pending)
  adminStatus               UserAdminStatus    @default(active)

  // Attachment IDs for provider verification images.
  frontSideCertificateImage String?
  backSideCertificateImage  String?
  faceImageFromFrontCam     String?

  isDeleted                 Boolean            @default(false)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([userId, isDeleted])
  @@index([providerApprovalStatus, isDeleted])
  @@index([adminStatus, isDeleted])
}


// Source: user/userRoleData.prisma
