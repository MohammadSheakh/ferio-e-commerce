// Source: cart.module/cart.prisma
enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

model Cart {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  status    CartStatus @default(ACTIVE)
  expiresAt DateTime

  items         CartItem[]
  checkoutDraft CheckoutDraft?
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
  @@index([updatedAt])
  @@index([userId, status, updatedAt])
}

model CartItem {
  id             String @id @default(cuid())
  quantity       Int
  addedUnitPrice Int

  cartId String
  cart   Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model SavedCart {
  id          String   @id @default(cuid())
  name        String
  shareToken  String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       SavedCartItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([shareToken])
}

model SavedCartItem {
  id          String         @id @default(cuid())
  quantity    Int            @default(1)
  savedCartId String
  savedCart   SavedCart      @relation(fields: [savedCartId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([savedCartId, variantId])
  @@index([variantId])
}


// Source: catalog.module/catalog.prisma
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum ProductCondition {
  NEW
  SECOND_HAND
}

enum ProductConditionGrade {
  LIKE_NEW
  GOOD
  FAIR
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  services ServiceOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, isActive, sortOrder])
  @@index([isActive, sortOrder, name])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, name])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  brand          String?
  brandId        String?
  brandRel       Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  codAvailable   Boolean       @default(true)
  deliveryNote   String?
  returnNote     String?
  condition      ProductCondition      @default(NEW)
  conditionGrade ProductConditionGrade?
  conditionNote  String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  media      ProductMedia[]
  reviewBanners ProductReviewBanner[]
  youtubeReviews ProductYoutubeReview[]
  features   ProductFeature[]
  specifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status, createdAt])
  @@index([brandId])
  @@index([status, isFeatured, publishedAt])
  @@index([name])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  group     String   @default("General")
  key       String
  value     String
  sortOrder Int      @default(0)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductFeature {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  tag         String?
  sortOrder   Int      @default(0)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

enum ProductYoutubeReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReviewBanner {
  id        String  @id @default(cuid())
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
}

model ProductYoutubeReview {
  id             String                     @id @default(cuid())
  youtubeUrl     String
  youtubeVideoId String
  title          String?
  reviewerName   String?
  status         ProductYoutubeReviewStatus @default(PENDING)
  isFeatured     Boolean                    @default(false)
  rejectionReason String?
  submittedById  String
  moderatedById  String?
  moderatedAt    DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  submittedBy User @relation("YoutubeReviewSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  moderatedBy User? @relation("YoutubeReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, youtubeVideoId])
  @@index([productId, status, isFeatured, createdAt])
  @@index([submittedById, createdAt])
}

model ProductVariant {
  id             String  @id @default(cuid())
  name           String
  sku            String  @unique
  attributes     Json?
  price          Int
  compareAtPrice Int?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  weightGrams    Int?

  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     ProductMedia[]
  inventory InventoryStock[]
  cartItems CartItem[]
  orderItems OrderItem[]
  savedCartItems SavedCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
  @@index([price])
}

model ProductMedia {
  id        String           @id @default(cuid())
  url       String
  altText   String?
  type      ProductMediaType @default(IMAGE)
  sortOrder Int              @default(0)

  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

enum ProductRequestStatus {
  PENDING
  COLLECTED
  CONTACTED
  DONE
}

model ProductRequest {
  id          String               @id @default(cuid())
  productName String
  name        String?
  phone       String?
  status      ProductRequestStatus @default(PENDING)
  notes       String?

  userId String?
  user   User?   @relation("ProductRequestUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}



// Source: chatting.module/conversation.prisma
enum ConversationType {
  direct
  group
}

enum ParticipantRole {
  admin
  member
}

model Conversation {
  id                   String   @id @default(cuid())

  // 🔗 Many conversations can be created by one user.
  creatorId            String
  creator              User     @relation("ConversationCreator", fields: [creatorId], references: [id])

  type                 ConversationType
  groupName            String?
  groupProfilePicture  String?

  // Last message snapshot for faster conversation list loading.
  lastMessageId        String?
  lastMessageText      String?
  lastMessageCreatedAt DateTime?
  isDeleted            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // 🔗 One conversation can have many participants.
  participants ConversationParticipents[]

  // 🔗 One conversation can have many messages.
  messages     Message[]

  // 🔗 One conversation can have many read-status rows.
  readStatuses MessageReadStatus[]


  @@index([creatorId, isDeleted])
  @@index([type, isDeleted])
  @@index([lastMessageCreatedAt, isDeleted])
}


// Source: chatting.module/conversationParticipents.prisma
model ConversationParticipents {
  id                         String          @id @default(cuid())

  // 🔗 Many participant rows can belong to one user.
  userId                     String
  user                       User            @relation(fields: [userId], references: [id])
  userName                   String

  // 🔗 Many participant rows can belong to one conversation.
  conversationId             String
  conversation               Conversation    @relation(fields: [conversationId], references: [id])
  joinedAt                   DateTime        @default(now())
  role                       ParticipantRole
  lastMessageReadAt          DateTime?
  lastMessageReadId          String?
  unreadCount                Int             @default(0)
  isThisConversationUnseen   Int             @default(0)
  isDeleted                  Boolean         @default(false)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([userId, conversationId, isDeleted])
  @@index([conversationId, isDeleted])
  @@index([userId, isDeleted])
}


// Source: chatting.module/message.prisma
model Message {
  id             String       @id @default(cuid())
  text           String

  // 🔗 Many messages can be sent by one user.
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])

  // 🔗 Many messages can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // 🔗 One-to-many: one message can include many attachments.
  attachments  Attachment[]

  // 🔗 One message can have many read-status rows, one per reader.
  readStatuses MessageReadStatus[]

  @@index([conversationId, createdAt, isDeleted])
  @@index([senderId, isDeleted])
  @@index([createdAt, isDeleted])
}


// Source: chatting.module/messageReadStatus.prisma
model MessageReadStatus {
  id             String       @id @default(cuid())

  // 🔗 Many read-status rows can belong to one message.
  messageId      String
  message        Message      @relation(fields: [messageId], references: [id])

  // 🔗 Many read-status rows can belong to one user.
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // 🔗 Many read-status rows can belong to one conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([messageId, userId])
  @@index([messageId, userId, isDeleted])
  @@index([conversationId, userId, isRead])
  @@index([userId, isRead])
}


// Source: checkout.module/checkout.prisma
