enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductMediaType {
  IMAGE
  VIDEO
}

enum ProductCondition {
  NEW
  SECOND_HAND
}

enum ProductConditionGrade {
  LIKE_NEW
  GOOD
  FAIR
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  services ServiceOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, isActive, sortOrder])
  @@index([isActive, sortOrder, name])
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logoUrl     String?
  isActive    Boolean   @default(true)

  products    Product[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, name])
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  brand          String?
  brandId        String?
  brandRel       Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  codAvailable   Boolean       @default(true)
  deliveryNote   String?
  returnNote     String?
  condition      ProductCondition      @default(NEW)
  conditionGrade ProductConditionGrade?
  conditionNote  String?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants   ProductVariant[]
  media      ProductMedia[]
  reviewBanners ProductReviewBanner[]
  youtubeReviews ProductYoutubeReview[]
  features   ProductFeature[]
  specifications ProductSpecification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, status, createdAt])
  @@index([brandId])
  @@index([status, isFeatured, publishedAt])
  @@index([name])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  group     String   @default("General")
  key       String
  value     String
  sortOrder Int      @default(0)

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
}

model ProductFeature {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String?
  tag         String?
  sortOrder   Int      @default(0)

  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, sortOrder])
}

enum ProductYoutubeReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReviewBanner {
  id        String  @id @default(cuid())
  imageUrl  String
  altText   String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
}

model ProductYoutubeReview {
  id             String                     @id @default(cuid())
  youtubeUrl     String
  youtubeVideoId String
  title          String?
  reviewerName   String?
  status         ProductYoutubeReviewStatus @default(PENDING)
  isFeatured     Boolean                    @default(false)
  rejectionReason String?
  submittedById  String
  moderatedById  String?
  moderatedAt    DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  submittedBy User @relation("YoutubeReviewSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  moderatedBy User? @relation("YoutubeReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, youtubeVideoId])
  @@index([productId, status, isFeatured, createdAt])
  @@index([submittedById, createdAt])
}

model ProductVariant {
  id             String  @id @default(cuid())
  name           String
  sku            String  @unique
  attributes     Json?
  price          Int
  compareAtPrice Int?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
  weightGrams    Int?

  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     ProductMedia[]
  inventory InventoryStock[]
  cartItems CartItem[]
  orderItems OrderItem[]
  savedCartItems SavedCartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, isActive, sortOrder])
  @@index([price])
}

model ProductMedia {
  id        String           @id @default(cuid())
  url       String
  altText   String?
  type      ProductMediaType @default(IMAGE)
  sortOrder Int              @default(0)

  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

enum ProductRequestStatus {
  PENDING
  COLLECTED
  CONTACTED
  DONE
}

model ProductRequest {
  id          String               @id @default(cuid())
  productName String
  name        String?
  phone       String?
  status      ProductRequestStatus @default(PENDING)
  notes       String?

  userId String?
  user   User?   @relation("ProductRequestUser", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

