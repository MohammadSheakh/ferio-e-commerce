enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CANCELLED
  DELIVERED
  COMPLETED
}

enum OrderPaymentStatus {
  UNPAID
  PAID
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum OrderFulfillmentStatus {
  UNFULFILLED
  READY_FOR_FULFILLMENT
  PICKING
  PACKED
  QUALITY_CHECKED
  READY_FOR_HANDOVER
  HANDED_OVER
  CANCELLED
  FULFILLED
}

enum FulfillmentExceptionType {
  SHORTAGE
  SUBSTITUTION
  OTHER
}

enum FulfillmentExceptionStatus {
  OPEN
  RESOLVED
}

enum OrderShipmentStatus {
  NOT_CREATED
  READY
  CREATED
  PICKED_UP
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_IN_PROGRESS
  RETURNED
  CANCELLED
  FAILED
  RTO
  UNKNOWN
}

enum OrderReturnStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
}

enum OrderRefundStatus {
  NONE
  PENDING
  PARTIAL
  REFUNDED
  FAILED
}

enum CodVerificationStatus {
  REQUIRED
  NOT_REQUIRED
  VERIFIED
  FAILED
}

enum OrderHistorySource {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum CodVerificationMode {
  ALWAYS
  ABOVE_AMOUNT
  NEVER
}

model CodVerificationPolicy {
  id              String              @id @default("default")
  mode            CodVerificationMode @default(ALWAYS)
  amountThreshold Int?
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())
}

model Order {
  id                 String                 @id @default(cuid())
  reference          String                 @unique
  idempotencyKeyHash String                 @unique
  status             OrderStatus            @default(PENDING_CONFIRMATION)
  paymentStatus      OrderPaymentStatus     @default(UNPAID)
  fulfillmentStatus  OrderFulfillmentStatus @default(UNFULFILLED)
  shipmentStatus     OrderShipmentStatus    @default(NOT_CREATED)
  returnStatus       OrderReturnStatus      @default(NONE)
  refundStatus       OrderRefundStatus      @default(NONE)
  codVerification    CodVerificationStatus  @default(REQUIRED)

  deliveryMethod      DeliveryMethod        @default(HOME_DELIVERY)
  pickupStoreId       String?
  pickupStore         Warehouse?            @relation(fields: [pickupStoreId], references: [id], onDelete: SetNull)
  preferredPickupDate DateTime?
  preferredPickupSlot String?
  storePickupStatus   StorePickupStatus     @default(NOT_APPLICABLE)
  storePickupOtp      String?
  customerPickupNotes String?
  pickupScheduledAt   DateTime?

  paymentMethod      CheckoutPaymentMethod  @default(COD)
  currency           String                 @default("BDT")

  subtotal      Int
  discountTotal Int @default(0)
  couponCode    String?
  deliveryFee   Int
  paymentCharge Int @default(0)
  total          Int

  source   String?
  medium   String?
  campaign String?
  customerNote String?
  purchaseActivityConsent Boolean @default(false)

  cancellationReason String?
  confirmedAt        DateTime?
  cancelledAt        DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  assignedDeliveryPersonnelId String?
  assignedDeliveryPersonnel   DeliveryPersonnel? @relation(fields: [assignedDeliveryPersonnelId], references: [id], onDelete: SetNull)

  checkoutDraftId String        @unique
  checkoutDraft   CheckoutDraft @relation(fields: [checkoutDraftId], references: [id], onDelete: Restrict)

  address      OrderAddress?
  items        OrderItem[]
  statusHistory OrderStatusHistory[]
  fulfillmentHistory FulfillmentHistory[]
  fulfillmentExceptions FulfillmentException[]
  shipment    Shipment?
  returnCases ReturnCase[]
  refunds     CommerceRefund[]
  rtoCases    RtoCase[]
  codCollection CodCollection?
  paymentAttempts CommercePaymentAttempt[]
  walletTransactions WalletTransactionHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([purchaseActivityConsent, status, createdAt])
  @@index([customerId, createdAt])
  @@index([assignedDeliveryPersonnelId, status])
  @@index([pickupStoreId])
  @@index([deliveryMethod, storePickupStatus])
  @@index([createdAt])
}

model OrderAddress {
  id              String @id @default(cuid())
  recipientName   String
  phoneOriginal   String
  phoneNormalized String
  email           String?
  district        String
  area            String
  detailedAddress String
  landmark        String?
  latitude        Float?
  longitude       Float?

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([phoneNormalized])
  @@index([district, area])
}

model OrderItem {
  id               String  @id @default(cuid())
  productIdSnapshot String
  productName       String
  variantName       String
  sku               String
  attributes        Json?
  imageUrl           String?
  productCondition   ProductCondition      @default(NEW)
  conditionGrade     ProductConditionGrade?
  conditionNote      String?
  unitPrice          Int
  discountTotal      Int     @default(0)
  taxTotal           Int     @default(0)
  weightGrams        Int
  quantity           Int
  lineTotal          Int

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  reservations InventoryReservation[]
  fulfillmentExceptions FulfillmentException[]
  returnItems ReturnItem[]
  rtoItems    RtoItem[]
  warrantyClaims WarrantyClaim[]

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([variantId])
  @@index([sku])
}

model OrderStatusHistory {
  id        String             @id @default(cuid())
  oldStatus OrderStatus?
  newStatus OrderStatus
  source    OrderHistorySource
  actorId   String?
  note      String?

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model FulfillmentHistory {
  id        String                 @id @default(cuid())
  oldStatus OrderFulfillmentStatus?
  newStatus OrderFulfillmentStatus
  source    OrderHistorySource
  actorId   String?
  note      String?

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([actorId, createdAt])
}

model FulfillmentException {
  id          String                     @id @default(cuid())
  type        FulfillmentExceptionType
  status      FulfillmentExceptionStatus @default(OPEN)
  quantity    Int?
  description String
  resolution  String?
  actorId     String
  resolvedByActorId String?
  resolvedAt  DateTime?

  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status, createdAt])
  @@index([orderItemId])
  @@index([actorId, createdAt])
}

model InventoryReservation {
  id       String                     @id @default(cuid())
  quantity Int
  status   InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime?
  releasedAt DateTime?
  consumedAt DateTime?

  inventoryId String
  inventory   InventoryStock @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  rtoItem     RtoItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inventoryId, orderItemId])
  @@index([status, expiresAt])
  @@index([orderItemId])
}
