{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "globalSetup": "<rootDir>/test/integration-global-setup.js",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/(.*)$": "<rootDir>/libs/$1/src"
  }
}
